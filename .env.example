# 复制为 .env.local 后按需修改

# 是否使用本地 mock 数据（true/不填=mock，false=接 Strapi）
NEXT_PUBLIC_USE_MOCK=true

# Strapi 地址，NEXT_PUBLIC_USE_MOCK=false 时必填
# NEXT_PUBLIC_STRAPI_URL=https://api.xxx.com

# Strapi 只读 API Token（仅服务端使用），NEXT_PUBLIC_USE_MOCK=false 时必填
# STRAPI_TOKEN=

# 站点公网地址，用于 SEO metadataBase 与远程图片白名单（可选）
# NEXT_PUBLIC_SITE_URL=https://www.xxx.com
